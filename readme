# creamos el script de lanzamiento
sudo nano /home/dw/start_kiosko.sh
sudo chmod +x /home/dw/start_kiosko.sh

#instalamos xinit
sudo apt install --no-install-recommends xinit

# configuramos xinit
sudo nano ~/.xinitrc
sudo chmod +x ~/.xinitrc

# agregamos xinit al bash
sudo nano ~/.bashrc
if [[ -z $DISPLAY ]] && [[ $(tty) = /dev/tty1 ]]; then
    startx
fi

# configuramos el servicio
sudo nano /etc/systemd/system/lancher_kiosk.service

# reiniciamos los servicios
sudo systemctl daemon-reload
sudo systemctl enable lancher_kiosk.service
sudo systemctl start lancher_kiosk.service

# para iniciar la raspberry modo kiosko sin escritorio
sudo systemctl disable lightdm
sudo systemctl set-default multi-user.target
sudo reboot

# para iniciar la rapberry con scritorio
sudo systemctl enable lightdm
sudo systemctl set-default graphical.target
sudo reboot

# si algo no funciona revisa los logs
cat /home/dw/launch_kiosk.log

# instalar dependencias manualmente
npm install --legacy-peer-deps  

